<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quantumgpt.huanxin-ai2-daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/daxu/software/quantum-gpt/browser-automation/huanxin_browser_daemon.js</string>
    <string>ai2</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/daxu/software/quantum-gpt</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HUANXIN_PROFILE_COPY_NAME</key>
    <string>quantum-rnd</string>
    <key>HUANXIN_HEADLESS</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/huanxin-daemon-ai2.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/huanxin-daemon-ai2.log</string>
</dict>
</plist>
