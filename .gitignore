browser-automation/*.png
browser-automation/*.jpg
browser-automation/*.jpeg
browser-automation/*.html
browser-automation/*.json
browser-automation/_hx_capture_probe.js
docs/external/
page-shot.png

# Local agent/runtime state (not for version control)
.agents/
.claude/
.git_ssh/
.huanxin_jobs/
.huanxin_ai_jobs/
.huanxin_envs.json
.huanxin_automation_enabled
.huanxin_automation_enabled.disabled-*

# macOS metadata
.DS_Store

# Secrets — never commit
*.env
*.env.*
.*.env
*.pem
*.key
*secret*
*credentials*

# RAG index artifacts (rebuilt locally, not committed)
artifacts/quantum-rag/*.pkl.gz
artifacts/quantum-rag/answer-cache.jsonl
artifacts/quantum-rag/qwen36-*.json

# Local debug snapshots / probe artifacts (rebuilt locally)
artifacts/ai3-*.json
artifacts/ai3-*.png
artifacts/*-probe.json
artifacts/*-debug.png
artifacts/asi1-signed-wheel-urls-*.env
# Large local-only artifact dirs (backups, downloads, uploads)
artifacts/branch-switch-backups/
artifacts/downloads/
artifacts/mistral_qiskit_upload/
artifacts/asi3_fetch/
artifacts/*.tar.gz
artifacts/*.patch

# Heavy model weights / training outputs (live on NAS + S3, not git)
models/**/!(*.md|*.txt)
outputs/**/*.safetensors
outputs/**/*.bin
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.ckpt
outputs/**/*.npy
outputs/**/*.msgpack
logs/

# Generated dataset archives / stale teacher snapshots (regenerated by pipeline)
data/generated/_flash_archive_*/
data/generated/_stale_teacher_archive_*/
data/generated/**/*_report.json
data/generated/**/*_report_converted.json

# Python bytecode
__pycache__/
*.pyc

# Prebuilt binaries / preseed downloads (fetched on demand, not version-controlled)
tools/codex-aarch64-unknown-linux-musl
tools/preseed/
tools/wheels/
opus_qa_batches/

# Large generated training data (regenerated by pipeline; backed up to S3)
isq_train_cot.json
data/seed/quantum_distillation_seed_questions_asi2_v1.jsonl
