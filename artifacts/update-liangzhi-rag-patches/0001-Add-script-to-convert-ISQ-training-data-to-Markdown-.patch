+
+```isq
+import std;
+qbit q[2];
+
+procedure main() {
+    // 这是典型的Clifford电路操作
+    // 就像按照固定规则移动货物，经典电脑很容易追踪
+    H(q[0]);
+    CNOT(q[0], q[1]);
+
+    // 如果取消下面这行注释，引入T门（非Clifford门），
+    // 经典电脑的简易记账法就会失效，计算量将呈指数级爆炸
