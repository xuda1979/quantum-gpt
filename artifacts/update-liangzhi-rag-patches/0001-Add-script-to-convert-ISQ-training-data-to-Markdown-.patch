+
+qbit q[1];
+
+procedure main() {
+    // 演示量子Zeno效应
+    // 我们设定将一个 pi/2 的旋转分为 10 份，即每次旋转 pi/20
+    // 每次旋转后立即进行测量
+    for i in 0:10 {
+        // 应用小角度 Rx 门
+        Rx(0.15707963267948966, q[0]); // pi/20 约等于 0.157
+        // 执行测量，观察者介入导致波函数发生坍缩
+        // 频繁的 M 操作将使得状态被强行拉回本征态
+        M(q[0]);
+    }
+}
