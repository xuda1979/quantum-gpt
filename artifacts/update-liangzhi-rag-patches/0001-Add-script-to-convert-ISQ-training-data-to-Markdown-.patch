+    Rz(phi_2, q[0]);
+    Rx(theta_x, q[0]);
+    
+    // 第3层：利用对称性，复用 phi_1 (等效于 d-1 位置)
+    Rz(phi_1, q[0]);
+    Rx(theta_x, q[0]);
+    
+    // 第4层：利用对称性，复用 phi_0 (等效于 d 位置)
+    Rz(phi_0, q[0]);
+    
+    // 此时 |0> 态的概率幅即为目标偶多项式的值
+    int result = M(q[0]);
+    
+    // 经典重置操作
+    if (result == 1) {
+        X(q[0]);
+    }
+}
