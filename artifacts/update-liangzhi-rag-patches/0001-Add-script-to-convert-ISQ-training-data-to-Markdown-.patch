+        ctrl @[c[0]] CNOT(p[0], p[1]);
+        ctrl @[c[0]] X(p[0]);
+        
+        // 当硬币为 |0> 时，位置在模4意义下减1（左移）
+        // 模4减法器逻辑：(最低位翻转，然后高位受低位控制翻转)
