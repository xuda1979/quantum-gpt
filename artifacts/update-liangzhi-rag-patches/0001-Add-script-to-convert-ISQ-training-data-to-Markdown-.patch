+    H(q[0]);
+    CNOT(q[0], q[1]);
+    
+    // 演化过程中插入典型的Clifford门序列以生成近Clifford训练电路数据
+    // 这里使用S门和Hadamard门构造Clifford演化
+    S(q[0]);
+    H(q[1]);
+    CNOT(q[0], q[1]);
+    Z(q[0]);
+    
+    // 测量各个量子比特以获取计算基矢下的概率分布（期望值）
+    M(q[0]);
+    M(q[1]);
+}
