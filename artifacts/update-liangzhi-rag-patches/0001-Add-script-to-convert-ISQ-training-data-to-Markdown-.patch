+
+qbit q[4];
+
+procedure main() {
+    // 编译器优化：并行化操作以最小化电路深度
+    // 第一层深度：同时作用两个H门
+    H(q[0]);
+    H(q[2]);
+    
+    // 第二层深度：同时作用两个CNOT门
