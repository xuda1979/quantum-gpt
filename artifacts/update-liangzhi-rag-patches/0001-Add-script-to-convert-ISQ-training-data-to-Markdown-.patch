+import std;
+
+// 声明一个量子比特作为数据载体
+qbit q[1];
+
+procedure main() {
+    // 准备初始量子态（相当于准备一段未经处理的原始声音）
+    X(q[0]);
+
+    // --- 开始QSVT变换（启动调音台） ---
