+    CNOT(q[2], q[4]);
+    int s2 = M(q[4]);
+
+    // 5. 经典解码与纠错控制
+    // 根据测量得到的伴随式 恢复正确的量子态
+    if (s1 == 1) {
+        if (s2 == 1) {
+            // 伴随式为 11，表示中间的 q[1] 发生了翻转
+            X(q[1]);
+        } else {
