+
+qbit q[2];
+
+procedure main() {
+    // 准备目标比特 (q[1]) 为 |-\rangle 态
+    // |-\rangle = X|1\rangle 或者是 H|1\rangle
+    X(q[1]);
+    H(q[1]);
+
+    // 准备控制比特 (q[0]) 为 |+\rangle 态
+    H(q[0]);
+
+    // 执行受控-Z门，发生相位回踢
+    CZ(q[0], q[1]);
+
+    // 再次对控制比特施加Hadamard门
+    H(q[0]);
+
+    // 此时测量控制比特 q[0]，由于相位回踢机制，
+    // 理论上将以 100% 的概率得到结果 1。
+    // (如果目标比特初始处于 |+\rangle 态，则测量结果将为 0)
+    int r = M(q[0]);
+    
+    // 如果需要还原初始基态以备后续计算，可以加入经典控制
