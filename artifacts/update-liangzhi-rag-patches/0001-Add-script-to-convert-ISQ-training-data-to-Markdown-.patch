+    real phi_1 = -0.5678;
+    real phi_2 = 1.5708; // 中心相位
+    
+    // 定义信号映射角（通常 W(x) = Rx(arccos(x))，这里设 arccos(x) = pi/3）
+    real theta_x = pi / 3; 
+    
+    // 初始化量子态至 |+> 态，以便提取非对角或对角元
+    H(q[0]);
+    
+    // 第0层：相位旋转与信号旋转
+    Rz(phi_0, q[0]);
+    Rx(theta_x, q[0]);
+    
+    // 第1层：利用对称性的前半部分
+    Rz(phi_1, q[0]);
+    Rx(theta_x, q[0]);
+    
