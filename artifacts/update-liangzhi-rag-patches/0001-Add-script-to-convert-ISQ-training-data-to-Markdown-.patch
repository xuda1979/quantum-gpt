+    
+    // --- 实现 U_p = exp(-i * theta * X[0] Y[1]) ---
+    
+    // 步骤1：基变换 V = H_0 S^\dagger_1
+    H(q[0]);
+    inv S(q[1]);
+    
+    // 步骤2：将 ZZ 相互作用转化为单比特旋转
+    // 利用 CNOT 计算奇偶性
+    CNOT(q[0], q[1]);
+    
+    // 施加 Rz(2*theta) 门，对应推导中的 e^{-i \theta Z_i Z_j}
+    Rz(2.0 * theta, q[1]);
+    
+    // 撤销奇偶性计算
+    CNOT(q[0], q[1]);
+    
+    // 步骤3：逆基变换 V^\dagger = H_0 S_1
+    H(q[0]);
+    S(q[1]);
+}
+```
