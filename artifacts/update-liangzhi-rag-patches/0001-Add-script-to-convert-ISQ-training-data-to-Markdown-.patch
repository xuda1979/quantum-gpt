+```isq
+import std;
+
+// 全局声明3个量子比特，对应3个图节点
+qbit q[3];
+
+procedure main() {
+    // 1. 制备均匀叠加态作为初态
+    for i in 0:3 {
+        H(q[i]);
+    }
+
+    // 假设经过经典优化器寻优得到的独立最优参数
+    // 对应边(0,1), (1,2), (2,0) 的问题参数
+    float gamma_01 = 0.52;  
+    float gamma_12 = 0.85;
+    float gamma_20 = 1.21; 
+
+    // 对应节点 0, 1, 2 的混合参数
+    float beta_0 = 0.41;
+    float beta_1 = 0.63;
+    float beta_2 = 0.92;
+
+    // 2. 构建问题哈密顿量演化 (独立的 ZZ 旋转)
+    // ZZ(0,1)
+    CNOT(q[0], q[1]);
+    Rz(2 * gamma_01, q[1]);
+    CNOT(q[0], q[1]);
+
+    // ZZ(1,2)
+    CNOT(q[1], q[2]);
+    Rz(2 * gamma_12, q[2]);
+    CNOT(q[1], q[2]);
+
+    // ZZ(2,0)
+    CNOT(q[2], q[0]);
+    Rz(2 * gamma_20, q[0]);
+    CNOT(q[2], q[0]);
+
+    // 3. 构建混合哈密顿量演化 (独立的 RX 旋转)
+    Rx(2 * beta_0, q[0]);
+    Rx(2 * beta_1, q[1]);
+    Rx(2 * beta_2, q[2]);
+
+    // 4. 在计算基下测量量子比特
+    for i in 0:3 {
+        M(q[i]);
+    }
+}
+```
