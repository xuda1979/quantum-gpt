+```isq
+import std;
+
+// 全局声明2个量子比特用于模拟纠缠对
+qbit q[2];
+
+procedure main() {
+    // ==========================================
+    // 1. 制备纠缠态：施加H门和CNOT门产生 |Phi+>
+    // ==========================================
+    H(q[0]);
+    CNOT(q[0], q[1]);
+
+    // ==========================================
+    // 2. Alice的编码阶段
+    // 假设需要安全传输的经典信息为 1
+    // ==========================================
+    int message_bit = 1;
+    // 若 message_bit 为 1，Alice 对其持有的 q[0] 施加 Z 门操作
+    // 若为 0，则执行 I 门 (空操作)
+    if (message_bit == 1) {
+        Z(q[0]);
+    }
+
+    // 在真实的QSDC中，此处会经过安全检测过程，确认无窃听后再发送给Bob
+    // 此处模拟经过传输后，Bob同时持有 q[0] 和 q[1]
