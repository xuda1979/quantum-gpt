+    CNOT(q[1], q[2]);
+    
+    // 4. 再次对输入比特施加Hadamard门，引发量子干涉
+    H(q[0]);
+    H(q[1]);
+    
+    // 5. 测量输入比特
+    // 如果是常函数，结果必为 00；如果是平衡函数，结果必定包含 1（例如 11）
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+}
