+    // anc=10 -> 错误发生在 q[0]
+    nctrl @[anc[1]] CNOT(anc[0], q[0]);
+    // anc=11 -> 错误发生在 q[1]
+    Toffoli(anc[0], anc[1], q[1]);
+    // anc=01 -> 错误发生在 q[2]
