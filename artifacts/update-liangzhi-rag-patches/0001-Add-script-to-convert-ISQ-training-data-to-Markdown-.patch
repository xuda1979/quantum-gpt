+
+// 声明全局量子比特数组
+// q[0] 为辅助比特，用于控制和最终测量
+// q[1] 为第一个输入态 |psi>
+// q[2] 为第二个输入态 |phi>
+qbit q[3];
+
+procedure main() {
+    // 1. 制备待测试的量子态
+    // 这里以任意旋转态为例，通过Ry门分别制备两个不同的量子态
+    // 将 q[1] 绕Y轴旋转 pi/3，制备出特定的 |psi>
+    Ry(pi/3, q[1]);
+    // 将 q[2] 绕Y轴旋转 pi/2，制备出特定的 |phi>
+    Ry(pi/2, q[2]);
+
+    // 2. 开始 Swap 测试量子线路
+    // 对辅助比特 q[0] 施加 Hadamard 门，进入均匀叠加态
