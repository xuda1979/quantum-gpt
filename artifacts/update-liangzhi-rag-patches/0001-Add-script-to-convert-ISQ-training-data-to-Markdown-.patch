+
+```isq
+import std;
+
+// 声明3个量子比特，q[0]和q[1]为查询输入，q[2]为辅助比特
+qbit q[3];
+
+procedure main() {
+    // 1. 初始化辅助比特为 |1>，以便后续产生相位反转
+    X(q[2]);
+    
+    // 2. 将所有量子比特转化为叠加态
+    H(q[0]);
+    H(q[1]);
+    H(q[2]);
+    
+    // 3. 执行Oracle查询：此处实现平衡函数 f(x0, x1) = x0 XOR x1
+    // 如果作为常函数测试，可以注释掉下面的CNOT门
