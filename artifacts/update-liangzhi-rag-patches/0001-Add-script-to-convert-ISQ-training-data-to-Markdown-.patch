+
+qbit q[2];
+
+procedure main() {
+    // 初始化量子比特
+    // 将第一个量子比特置于叠加态
+    H(q[0]);
+    
+    // 执行受控非门，利用声子总线让两个离子纠缠
+    CNOT(q[0], q[1]);
+    
