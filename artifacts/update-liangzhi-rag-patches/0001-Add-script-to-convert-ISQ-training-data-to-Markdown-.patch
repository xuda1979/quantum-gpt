+    // 第一层：在 (q[0], q[1]) 和 (q[2], q[3]) 上应用随机SU(4)
+    su4(q[0], q[1]);
+    su4(q[2], q[3]);
+
+    // 第二层：改变配对方式，例如 (q[1], q[2])，以测试不同比特间的门质量
+    su4(q[1], q[2]);
+
+    // ... 后续层继续应用随机配对的SU(4)门
+    // 硬件性能越好，能成功运行且保真度高于阈值的层数就越深
+
+    // 最后进行全系统测量，将结果分布与理想模拟分布进行比较（重概率测试）
+    for i in 0:4 {
+        M(q[i]);
+    }
+}
