+
+```isq
+import std;
+
+qbit q[2];
+
+// 定义代价哈密顿量演化过程
+procedure U_C(double gamma) {
+    // 假设问题哈密顿量包含一项 Z0*Z1
+    // 在isQ中利用 CNOT 和 Rz 门实现 e^{-i*gamma*Z0*Z1}
+    CNOT(q[0], q[1]);
+    Rz(2.0 * gamma, q[1]);
+    CNOT(q[0], q[1]);
+}
+
+// 定义混合哈密顿量演化过程
+procedure U_B(double beta) {
+    // 哈密顿量 X0 + X1，相当于对每个量子比特作用 Rx 门
+    for i in 0:2 {
+        Rx(2.0 * beta, q[i]);
+    }
+}
+
+procedure main() {
+    // 步骤1：初始化为 |+> 态
+    for i in 0:2 {
+        H(q[i]);
+    }
+
+    // 步骤2：第一层 QAOA (p=1)
+    // 假设通过经典优化器找到了 gamma1 和 beta1
+    double gamma1 = 0.5; 
+    double beta1 = 0.3;
+    U_C(gamma1);
+    U_B(beta1);
+
+    // 步骤3：第二层 QAOA (p=2)
+    // 第二组参数，进行深度微调
+    double gamma2 = 0.4;
+    double beta2 = 0.6;
+    U_C(gamma2);
+    U_B(beta2);
+
+    // 步骤4：测量输出
+    // 输出结果将展现出比 p=1 时更高的近似比
+    for i in 0:2 {
+        M(q[i]);
+    }
+}
+```
+
+通过这段代码你可以看到，增加 $p$ 在代码层面就是简单地增加 `U_C` 和 `U_B` 的交替调用次数。每一次调用，经典计算机都需要通过梯度下降等优化算法来寻找一组新的 $(\gamma, \beta)$，使得最后测量出的能量期望值更高（即近似比更大）。希望这个一步步的拆解能帮你彻底理清QAOA的内涵！
