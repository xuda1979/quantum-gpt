+
+import std;
+
+qbit q[1];
+
+procedure main() {
+    // U3(theta, phi, lambda) 门可以通过欧拉角分解为 Rz(phi) * Ry(theta) * Rz(lambda) 的组合
+    // 第一步：绕Z轴旋转角度 lambda = 0
+    Rz(0, q[0]);
+    
+    // 第二步：绕Y轴旋转角度 theta = pi/2
+    Ry(1.5707963, q[0]);
+    
+    // 第三步：绕Z轴旋转角度 phi = pi/2
+    Rz(1.5707963, q[0]);
+    
+    // 执行测量以观察最终量子态的概率分布
+    M(q[0]);
+}
+
