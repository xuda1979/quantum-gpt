+        if (s2 == 0) {
+            X(d[0]);
+        }
+    }
+    if (s1 == 1) {
+        if (s2 == 1) {
+            X(d[1]);
+        }
+    }
+    if (s1 == 0) {
+        if (s2 == 1) {
+            X(d[2]);
+        }
+    }
+}
+
+// 过程4：完整的纠错主流程（嵌套调用模式的体现）
+procedure run_error_correction_test() {
+    // 假设我们要保护一个 |+> 状态
+    H(data_q[0]);
+    
+    // 1. 调用编码过程
+    encode(data_q);
+    
+    // 2. 模拟环境引入的位翻转错误
+    // 我们故意在第二个物理比特上施加 X 门来模拟错误
+    X(data_q[1]);
