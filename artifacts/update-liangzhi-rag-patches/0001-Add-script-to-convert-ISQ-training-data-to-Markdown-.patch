+```isq
+import std;
+
+qbit q[1]; // 全局量子比特声明
+
+procedure main() {
+    // 1. 态准备算子 A：假设将期望值编码为 theta，此处设 2*theta = 1.0 弧度
+    // A|0> = cos(0.5)|0> + sin(0.5)|1>
+    Ry(1.0, q[0]);
+
+    // --- 开始构建 Q = - S_0 S_chi ---
+
+    // 2. S_chi 算子：对目标态 |1> 的相位进行反转 (即 Z 门)
+    // Z = |0><0| - |1><1| 
+    Z(q[0]);
+
+    // 3. A 的逆算子 (inv A)
+    inv Ry(1.0, q[0]);
+
+    // 4. S_0 算子：对初始态 |0> 的相位进行反转
+    // S_0 = X * H * Z * H * X (围绕X轴的反射)
+    X(q[0]);
+    H(q[0]);
+    Z(q[0]);
+    H(q[0]);
+    X(q[0]);
+
+    // 5. 再次应用 A 算子
+    Ry(1.0, q[0]);
+    
+    // 6. 补偿全局相位 -1 (因为 Q = - S_0 S_chi)
+    GPhase(3.14159265);
+
+    // 测量以验证振幅是否被放大
+    M(q[0]);
+}
+```
