+    // ==========================================
+    CNOT(q[0], q[1]);
+    H(q[0]);
+
+    // ==========================================
+    // 4. 测量与信息提取
+    // ==========================================
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+    // 在这个简化的模型下，r0 和 r1 的组合将直接反映出 Alice 的编码。
