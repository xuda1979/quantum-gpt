+// 定义系统量子比特数，假设包含4个自旋轨道
+const N = 4;
+// 全局声明量子比特数组
+qbit q[N];
+
+// 主程序入口
+procedure main() {
+    // ==========================================
+    // 1. 初始化 Hartree-Fock 参考态
+    // ==========================================
+    // 在量子化学中，Hartree-Fock态对应于能量最低的 Slater 行列式
+    // 假设前2个轨道被电子占据，对应计算基态 |0011>
+    // 因为量子比特状态默认为 |0>，我们通过对 q[0] 和 q[1] 执行 X 门将其翻转为 |1>
+    X(q[0]); // 第0个轨道占据1个电子
+    X(q[1]); // 第1个轨道占据1个电子
+
+    // ==========================================
+    // 2. 实现 Jordan-Wigner 演化
+    // ==========================================
+    // 演化目标算符：exp(-i * theta * (a_2^dagger + a_2))
+    // 映射为泡利字符串后为：exp(-i * theta * X_2 Z_1 Z_0)
+    // 我们选择旋转角度 theta 为 pi/4 进行演示
+    double theta = 3.1415926535 / 4.0;
+
+    // 步骤 A: 构建宇称计算阶梯 (CNOT 级联)
