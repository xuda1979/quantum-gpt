+
+qbit q[2];
+
+procedure main() {
+    // 1. 初始化：制备均匀叠加态
+    H(q[0]);
+    H(q[1]);
+
+    // 2. Oracle：翻转目标态 |11> 的相位
+    // 由于受控Z门(CZ)的作用恰好是在 |11> 态加上负号，因此可以直接使用
+    CZ(q[0], q[1]);
