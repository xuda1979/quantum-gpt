+qbit q[1];
+procedure main() {
+    // 初始化量子比特q[0]默认处于|0>态
+    // 应用Hadamard门
+    H(q[0]);
+    // 此时q[0]处于 (|0> + |1>)/sqrt(2) 的等概率叠加态
+    // 测量该量子比特
