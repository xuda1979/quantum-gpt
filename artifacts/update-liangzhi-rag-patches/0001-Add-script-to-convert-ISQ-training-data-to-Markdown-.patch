+
+qbit q[2];
+
+// 模拟 e^{-i J Z0 Z1 dt}
+procedure zz_interaction(double J, double dt) {
+    CNOT(q[0], q[1]);
+    Rz(2.0 * J * dt, q[1]);
+    CNOT(q[0], q[1]);
+}
+
+// 模拟 e^{-i h X0 dt}
+procedure x_field(double h, double dt) {
+    Rx(2.0 * h * dt, q[0]);
+}
+
+procedure main() {
+    // 参数初始化
+    double J = 0.5;
+    double h = 0.2;
+    double total_time = 1.0;
+    int r = 10; // 选择Trotter步数
+    double dt = total_time / r;
+
+    // 初始化态为 |00>
+    // 为测试，可将第一个qubit置于|+>态
+    H(q[0]);
+
+    // 进行 r 步Trotter演化
+    int i = 0;
+    for(i = 0; i < r; i = i + 1) {
+        zz_interaction(J, dt);
+        x_field(h, dt);
+    }
+
+    // 测量观测统计
+    return M(q[0]);
+}
+```
