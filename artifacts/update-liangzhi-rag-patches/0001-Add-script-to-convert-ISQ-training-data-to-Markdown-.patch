+isQ代码定义示例：
+import std;
+
+qbit q[2];
+
+procedure parameterized_entangle(double angle) {
+    H(q[0]);
+    CNOT(q[0], q[1]);
+    Rz(angle, q[0]);
+}
+
+procedure main() {
+    parameterized_entangle(3.14159 / 4.0);
+}
+</isie>
+
