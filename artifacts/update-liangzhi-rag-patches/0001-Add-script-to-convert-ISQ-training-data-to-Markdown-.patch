+qbit q[3];
+procedure main() {
+    H(q[0]);
+    CNOT(q[0], q[1]);
+    CNOT(q[0], q[2]);
+    // 此时系统状态演化为 $1/\sqrt{2}(|000\rangle + |111\rangle)$，即GHZ态
+}
