+import std;
+
+qbit data[4];
+qbit ancilla;
+
+procedure main() {
+    // 假设此时的数据比特处于包含潜在错误的任意态
+    // 甚至可以施加一个X错误以测试伴随式提取
+    // X(data[2]); 
+
+    // 初始化辅助量子比特
+    H(ancilla);
+
+    // 执行Z型稳定子测量 (Z1*Z2*Z3*Z4)
+    // 使用控制相位门或等效的控制Z门网络
+    CZ(data[0], ancilla);
+    CZ(data[1], ancilla);
+    CZ(data[2], ancilla);
+    CZ(data[3], ancilla);
+
+    // 将辅助比特旋转回计算基进行测量
+    H(ancilla);
+
+    // 测量辅助比特以获得特征值 (+1 或 -1)
+    int syndrome = M(ancilla);
+
+    // 如果syndrome为1，说明发生了错误翻转
+    if (syndrome == 1) {
+        // 记录错误伴随式，这里仅作演示打印或进一步处理
+        // 实际Willow芯片中会输入到解码器进行非易失性计算
+    }
+}
+```
+上述代码中，`ancilla` 的最终测量结果若为 0 对应本征值 $+1$，若为 1 对应本征值 $-1$，这一过程的数学本质与我们之前推导的 $\langle S_Z \rangle$ 完全一致。
