+    X(q[1]);
+    
+    // 使用CZ门翻转 |11> 的相位
+    CZ(q[0], q[1]);
+    
+    X(q[0]);
+    X(q[1]);
+    
+    H(q[0]);
+    H(q[1]);
+
+    // 4. 测量
+    // 此时量子态将坍缩为 |11>
