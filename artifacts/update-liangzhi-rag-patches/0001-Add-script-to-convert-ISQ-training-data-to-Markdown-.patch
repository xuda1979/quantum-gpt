+ import std;
+qbit q[2];
+procedure main() {
+    // 初始化量子态，模拟Hartree-Fock基态
+    // 假设活性空间中有2个电子占据前两个轨道
+    X(q[0]);
+    X(q[1]);
+
+    // 应用硬件高效拟设
+    // 为了对抗退相干，线路应尽可能浅
+    // 参数化单比特旋转层
+    for i in 0:2 {
+        Rx(0.5, q[i]);
+        Ry(0.5, q[i]);
+    }
+
+    // 量子比特之间的纠缠层，使用CZ门以适配部分硬件原生指令
+    CZ(q[0], q[1]);
+
+    // 第二层参数化旋转
+    for i in 0:2 {
+        Ry(0.5, q[i]);
+    }
+    // 测量统计概率
+    for i in 0:2 {
+        M(q[i]);
+    }
+} 
+
+在上述代码中，活性空间被映射到2个量子比特上，线路仅包含单比特旋转门和一层的CZ纠缠门。这种极浅的线路深度是应对NISQ设备退相干效应和有限门保真度的有效策略。
