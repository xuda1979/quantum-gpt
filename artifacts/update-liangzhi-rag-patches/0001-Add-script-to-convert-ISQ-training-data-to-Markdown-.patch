+import std;
+
+qbit q[1];
+
+procedure main() {
+    // 假设我们要实现一个任意单比特量子门，可以通过 Z-Y-Z 的旋转序列来实现
+    // 第一步：绕Z轴旋转 pi/4
+    Rz(pi/4, q[0]);
+    
+    // 第二步：绕Y轴旋转 pi/2
+    Ry(pi/2, q[0]);
+    
+    // 第三步：再次绕Z轴旋转 pi/3
+    Rz(pi/3, q[0]);
+    
+    // 这三步看似简单的旋转，组合起来就能实现布洛赫球面上任意姿态的精准变换
