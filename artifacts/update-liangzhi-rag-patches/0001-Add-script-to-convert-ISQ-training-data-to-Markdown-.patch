+import std;
+qbit q[4];
+procedure main() {
+    // 初始化所有量子比特为|+>态
+    for i in 0:4 {
+        H(q[i]);
+    }
+    // 应用相邻的CZ门生成一维簇态纠缠
+    CZ(q[0], q[1]);
+    CZ(q[1], q[2]);
+    CZ(q[2], q[3]);
+}
