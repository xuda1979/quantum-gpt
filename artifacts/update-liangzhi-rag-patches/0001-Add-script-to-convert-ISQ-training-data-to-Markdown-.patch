+    // 但测量会导致量子态坍缩，我们只能得到 00, 01, 10, 11 中的一个
+    // 而不是一次性获取包含所有并行演化路径的“完整气象图谱”
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+    // 打印出来的仅仅是一次随机采样的坍缩结果
+    print r0;
+    print r1;
