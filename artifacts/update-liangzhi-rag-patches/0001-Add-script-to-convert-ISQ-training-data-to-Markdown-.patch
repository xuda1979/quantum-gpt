+int basisA;
+int basisB;
+
+procedure main() {
+    // 1. 墨子号卫星（S）作为量子纠缠源，制备贝尔态 |Φ+> = (|00> + |11>)/√2
+    // 对第一个量子比特执行Hadamamrd门操作，使其进入叠加态
