+import std;
+
+qbit q[4];
+
+procedure main() {
+    // 假设已经将待分类的多体量子态（如具有不同拓扑相的态）制备在 q[0] 到 q[3] 中
+
+    // 卷积层 1: 相邻量子比特作用参数化纠缠门，提取局域纠缠特征
+    for i in 0:3 {
+        CNOT(q[i], q[(i+1)%4]);
+        Rz(0.5, q[(i+1)%4]);
+    }
+    
+    // 池化层 1: 测量部分量子比特以降低系统维度（粗粒化）
+    int r0 = M(q[0]);
+    int r2 = M(q[2]);
+    
+    // 根据测量结果，对保留下来的活跃量子比特施加条件旋转，实现信息融合
+    if (r0 == 1) {
+        Rx(0.3, q[1]);
+    }
+    if (r2 == 1) {
+        Rx(0.3, q[3]);
+    }
+    
+    // 卷积层 2: 在剩余的活跃量子比特上继续进行特征提取
+    CNOT(q[1], q[3]);
+    Rz(0.8, q[3]);
+    
+    // 池化层 2: 进一步降维
+    int r1 = M(q[1]);
+    if (r1 == 1) {
+        X(q[3]);
