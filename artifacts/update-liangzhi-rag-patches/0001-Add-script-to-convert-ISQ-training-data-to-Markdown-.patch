+
+import std;
+
+qbit q[2];
+
+procedure main() {
+    // 定义两个经典数据特征（通常在编码前需进行归一化处理，使其落入合适的区间如 [0, Pi]）
+    float x0 = 1.57; // 特征 1，近似 Pi/2
+    float x1 = 3.14; // 特征 2，近似 Pi
+
+    // 角度编码：通过绕 Y 轴的旋转门将特征值编码到对应量子比特的概率幅中
+    Ry(x0, q[0]);
+    Ry(x1, q[1]);
+
+    // 为了验证编码结果，可以对量子比特进行测量
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+}
