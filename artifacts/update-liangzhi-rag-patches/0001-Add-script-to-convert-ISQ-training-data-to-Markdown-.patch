+
+qbit q[2];
+
+procedure main() {
+    // 第一步：初始化哈达玛变换，将量子态制备为均匀叠加态
+    // 此时的状态代表包含所有四个碱基的等概率叠加
+    H(q[0]);
+    H(q[1]);
+
+    // 第二步：构建Oracle，标记目标碱基G（状态 |10>）
+    // 为了标记 |10>，我们可以先对第二个量子比特应用X门将其变为 |11>
+    // 接着使用CZ门进行相位翻转，然后再用X门恢复
+    X(q[1]); 
+    CZ(q[0], q[1]);
+    X(q[1]); 
+
+    // 第三步：构建Diffuser（幅度放大算子）
+    // 应用量子干涉原理，增加目标态的概率幅，同时抑制非目标态的概率幅
+    H(q[0]);
+    H(q[1]);
+    X(q[0]);
+    X(q[1]);
+    
+    // 使用H门、CNOT门、H门组合实现受控Z门
+    H(q[1]);
+    CNOT(q[0], q[1]);
+    H(q[1]);
+    
+    X(q[0]);
+    X(q[1]);
+    H(q[0]);
+    H(q[1]);
+
+    // 第四步：量子测量，坍缩量子态以获取搜索结果
+    M(q[0]);
+    M(q[1]);
+}
+```
