+    float theta1 = 1.2;
+    float theta2 = -0.8;
+    float theta3 = 0.3;
+    float theta4 = 0.9;
+    float theta5 = -1.1;
+
+    // 第一层参数化旋转 R_y
+    Ry(theta0, q[0]);
+    Ry(theta1, q[1]);
+
+    // 纠缠层：使用CNOT门产生量子比特间的纠缠
+    CNOT(q[0], q[1]);
+
+    // 第二层参数化旋转 R_z
