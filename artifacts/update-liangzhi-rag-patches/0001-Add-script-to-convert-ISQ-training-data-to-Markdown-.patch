+
+import std;
+
+qbit q[3];
+qbit anc[2];
+
+procedure main() {
+    // 1. 编码逻辑态：将 |0> 编码为 |000>
+    // 若包含叠加态则是 |psi> = a|000> + b|111>
+    H(q[0]);
+    CNOT(q[0], q[1]);
+    CNOT(q[0], q[2]);
+    
+    // 2. 注入单比特翻转错误 (t=1 错误，可以纠正)
