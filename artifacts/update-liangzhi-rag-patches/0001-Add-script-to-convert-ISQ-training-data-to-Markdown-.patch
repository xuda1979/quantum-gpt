+```isq
+import std;
+
+qbit q[4];
+
+procedure main() {
+    // 初始化：节点A和中间节点左侧(q1)建立纠缠
+    H(q[0]);
+    CNOT(q[0], q[1]);
+
+    // 初始化：中间节点右侧(q2)和节点B建立纠缠
+    H(q[2]);
+    CNOT(q[2], q[3]);
+
+    // 此时 q[0] 和 q[3] 之间没有任何关联
+
+    // 中间节点对 q[1] 和 q[2] 进行贝尔态测量
+    // 这是纠缠交换的核心操作
+    CNOT(q[1], q[2]);
+    H(q[1]);
+    
