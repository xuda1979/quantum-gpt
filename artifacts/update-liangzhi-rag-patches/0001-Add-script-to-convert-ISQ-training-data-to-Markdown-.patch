+
+// 全局声明量子比特
+qbit q[2];
+
+procedure main() {
+    // 1. 经典参数设定：模拟由经典优化器计算出的参数
+    // 在实际混合计算中，这个值由CPU在每次迭代时动态提供
+    theta = 0.785; // 对应约45度的角度
+
+    // 2. 参数化量子线路执行
+    // 制备纠缠初态
+    H(q[0]);
+    CNOT(q[0], q[1]);
+    
+    // 施加依赖经典参数theta的量子门
+    Ry(theta, q[0]);
+
+    // 3. 量子测量阶段：提取中间计算结果
+    // 对第0个量子比特进行测量，结果存入经典寄存器r0
+    int r0 = M(q[0]);
+
