+```isQ
+import std;
+
+qbit q[1];
+
+// 模拟Alice在BB84协议中制备量子态的过程
+// bit_val: 准备发送的随机比特 (0 或 1)
+// basis_val: 随机选择的基矢 (0 代表Z基矢计算基, 1 代表X基矢Hadamard基)
+procedure prepare_state(int basis_val, int bit_val) {
+    // 初始态默认为 |0>
+    if (basis_val == 0) {
+        // Z基矢: 0 -> |0>, 1 -> |1>
+        if (bit_val == 1) {
+            X(q[0]);
+        }
+    } else {
+        // X基矢: 0 -> |+>, 1 -> |- >
+        if (bit_val == 1) {
+            X(q[0]);
+        }
