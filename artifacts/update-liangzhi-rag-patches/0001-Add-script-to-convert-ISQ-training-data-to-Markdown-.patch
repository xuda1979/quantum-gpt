+    CNOT(q[1], q[2]);
+    Rz(2.0*dt, q[2]);
+    CNOT(q[1], q[2]);
+
+    // 测量演化后的量子态
+    for i in 0:N {
+        M(q[i]);
+    }
+}
+```
