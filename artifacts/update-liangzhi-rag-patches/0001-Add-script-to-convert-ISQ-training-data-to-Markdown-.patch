+    // 辅助比特 q[3] 用于测量 Z1Z2 的奇偶性
+    CNOT(q[0], q[3]);
+    CNOT(q[1], q[3]);
+    int s1 = M(q[3]);
+
+    // 辅助比特 q[4] 用于测量 Z2Z3 的奇偶性
