+    randomSU4(q[0], q[1]);
+    randomSU4(q[2], q[3]);
+
+    // 随机置换层：在实际 QV 中需通过随机 SWAP 或经典重映射实现
+    // 此处我们通过改变下一层门的控制目标来等效替代置换操作
+    randomSU4(q[1], q[2]);
+    randomSU4(q[0], q[3]);
+
+    // 测量以获取经典输出，用于后续的重输出概率统计
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+    int r2 = M(q[2]);
