+procedure main() {
+    // Prepare |+> on q[0], |-> on q[1]
+    H(q[0]);
+    X(q[1]);
+    H(q[1]);
+    // CNOT with phase kickback
+    CNOT(q[0], q[1]);
+    // Measure q[0] in X basis
+    H(q[0]);
+    // Measure q[1] in X basis
+    H(q[1]);
+    M(q[0]); M(q[1]);
+}
