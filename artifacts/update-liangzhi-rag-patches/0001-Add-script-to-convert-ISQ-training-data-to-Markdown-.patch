+    CNOT(q[1], q[2]);
+
+    // Alice 对 q[0] 和她拥有的 q[1] 执行贝尔基测量
+    CNOT(q[0], q[1]);
+    H(q[0]);
+
+    // 经典信道传输测量结果
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+
+    // Bob 根据经典信息对他拥有的 q[2] 进行相应的酉变换修正
+    if (r1 == 1) {
+        X(q[2]);
+    }
+    if (r0 == 1) {
+        Z(q[2]);
+    }
+}
+
