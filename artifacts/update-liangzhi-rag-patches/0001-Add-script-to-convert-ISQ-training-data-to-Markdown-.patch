+
+qbit q[1];
+
+procedure main() {
+    // 刚声明的量子比特 q[0] 默认处于 |0> 状态（相当于硬币正面朝上）
+    
+    // 我们施加 Pauli X 门，执行“取反”操作
+    X(q[0]);
+    
+    // 此时，q[0] 的状态已经翻转，变成了 |1> 状态（相当于硬币反面朝上）
+    
+    // 我们通过测量来验证结果
+    int result = M(q[0]);
+    // 在理想情况下，result 这个变量的值必定是 1
+}
