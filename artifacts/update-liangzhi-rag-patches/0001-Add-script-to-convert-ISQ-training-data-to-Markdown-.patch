+
+import std;
+
+qbit q[2];
+
+procedure main() {
+    // 对第一个量子比特施加Hadamard门，使其进入叠加态
+    H(q[0]);
+    // 以第一个量子比特为控制位，第二个为目标位施加CNOT门
+    CNOT(q[0], q[1]);
+    // 测量两个量子比特
+    int r0 = M(q[0]);
+    int r1 = M(q[1]);
+}
+
+在这段代码中，CNOT门将H门产生的叠加态转化为两个量子比特之间的深度纠缠，充分展现了该双比特门在量子线路中的核心机制。
