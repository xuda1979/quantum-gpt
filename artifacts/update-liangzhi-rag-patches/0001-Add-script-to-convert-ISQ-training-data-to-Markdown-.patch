+
+```isQ
+import std;
+
+qbit q[2];
+
+procedure main() {
+    // 初始化系统，默认处于 |00> 状态
+    
+    // 对第一个量子比特应用 Hadamard 门，创建叠加态
+    H(q[0]);
+    
+    // 应用 CNOT 门，在两个量子比特间建立最大纠缠
+    // 此时系统状态变为 (|00> + |11>) / sqrt(2)
+    CNOT(q[0], q[1]);
+    
+    // 此时该量子态的 Concurrence 为 1，纠缠熵为 1 bit
+}
+```
