+import std;
+
+// 声明4个全局量子比特
+qbit q[4];
+
+// 自定义参数化层，深度重复极易引发BPs
+procedure layer() {
+    // 单比特旋转层
+    for i in 0:4 {
+        Rx(0.5, q[i]);
+        Ry(0.5, q[i]);
+        Rz(0.5, q[i]);
+    }
+    
+    // 全局纠缠层：CNOT环形拓扑
+    for i in 0:3 {
+        CNOT(q[i], q[i+1]);
+    }
+    CNOT(q[3], q[0]);
+}
+
+procedure main() {
+    // 初始化
+    for i in 0:4 {
+        H(q[i]);
+    }
+    
+    // 深度堆叠拟设层，层数越多，贫瘠高原现象越显著
+    // 此处为了演示仅堆叠3层
+    for j in 0:3 {
+        layer();
+    }
+}
+```
