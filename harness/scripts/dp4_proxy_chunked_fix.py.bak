#!/usr/bin/env python3
"""Small Anthropic Messages -> Huanxin chat-completions proxy for Claude Code."""

from __future__ import annotations

import argparse
import io
import json
import os
import queue
import ssl
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import uuid
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any
from urllib.parse import urlparse

_TRUTHY = {"1", "true", "yes", "on"}
# X509_V_ERR_CERT_HAS_EXPIRED
_CERT_EXPIRED_CODE = 10

_DEBUG_LOG_PATH = os.environ.get("HUANXIN_PROXY_DEBUG_LOG", "").strip()


def debug_log(message: str) -> None:
    if not _DEBUG_LOG_PATH:
        return
    try:
        with open(_DEBUG_LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%H:%M:%S')} {message}\n")
    except Exception:
        pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--upstream-url", required=True)
    parser.add_argument("--upstream-token", required=True)
    parser.add_argument("--model-name", required=True)
    parser.add_argument(
        "--appcode",
        default="",
        help="Optional API-gateway appcode (JWT) sent as the X-Ca-Key header. "
        "Some Huanxin subscriptions (e.g. deepseekv4_master) require it.",
    )
    parser.add_argument(
        "--max-input-chars",
        type=int,
        default=int(os.environ.get("HUANXIN_PROXY_MAX_INPUT_CHARS", "24000")),
    )
    parser.add_argument(
        "--insecure",
        action="store_true",
        default=os.environ.get("HUANXIN_PROXY_INSECURE", "").strip().lower() in _TRUTHY,
        help="Skip upstream TLS certificate verification (also via HUANXIN_PROXY_INSECURE=1).",
    )
    return parser.parse_args()


def write_json(handler: BaseHTTPRequestHandler, status: int, payload: dict[str, Any]) -> None:
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    try:
        handler.send_response(status)
        handler.send_header("Content-Type", "application/json")
        handler.send_header("Content-Length", str(len(data)))
        handler.end_headers()
        handler.wfile.write(data)
    except (BrokenPipeError, ConnectionResetError):
        return


def text_from_content(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return "" if content is None else str(content)
    parts: list[str] = []
    for item in content:
        if isinstance(item, str):
            parts.append(item)
        elif isinstance(item, dict):
            item_type = item.get("type")
            if item_type == "text" and isinstance(item.get("text"), str):
                parts.append(item["text"])
            elif item_type == "tool_result":
                parts.append(text_from_content(item.get("content", "")))
    return "\n".join(part for part in parts if part)


def append_text_message(messages: list[dict[str, Any]], role: str, text: str) -> None:
    if text:
        messages.append({"role": role, "content": text})


def tool_arguments(value: Any) -> str:
    if isinstance(value, str):
        return value
    if value is None:
        return "{}"
    return json.dumps(value, separators=(",", ":"))


def parse_tool_input(arguments: Any) -> dict[str, Any]:
    if isinstance(arguments, dict):
        return arguments
    if isinstance(arguments, str) and arguments:
        try:
            parsed = json.loads(arguments)
        except Exception:
            return {"arguments": arguments}
        if isinstance(parsed, dict):
            return parsed
        return {"arguments": parsed}
    return {}


def convert_tools(raw_tools: Any) -> list[dict[str, Any]] | None:
    if not isinstance(raw_tools, list):
        return None
    tools: list[dict[str, Any]] = []
    for tool in raw_tools:
        if not isinstance(tool, dict):
            continue
        if tool.get("type") == "function" and isinstance(tool.get("function"), dict):
            function = tool["function"]
            name = function.get("name")
            if not isinstance(name, str) or not name:
                continue
            entry: dict[str, Any] = {"type": "function", "function": {"name": name}}
            if isinstance(function.get("description"), str):
                entry["function"]["description"] = function["description"]
            if isinstance(function.get("parameters"), dict):
                entry["function"]["parameters"] = function["parameters"]
            tools.append(entry)
            continue

        name = tool.get("name")
        if not isinstance(name, str) or not name:
            continue
        entry = {"type": "function", "function": {"name": name}}
        description = tool.get("description")
        input_schema = tool.get("input_schema")
        if isinstance(description, str) and description:
            entry["function"]["description"] = description
        if isinstance(input_schema, dict):
            entry["function"]["parameters"] = input_schema
        tools.append(entry)
    return tools or None


def convert_tool_choice(raw_choice: Any) -> Any:
    if raw_choice in {"auto", "none", "required"}:
        return raw_choice
    if not isinstance(raw_choice, dict):
        return None
    choice_type = raw_choice.get("type")
    if choice_type == "auto":
        return "auto"
    if choice_type == "none":
        return "none"
    if choice_type == "any":
        return "required"
    if choice_type == "tool" and isinstance(raw_choice.get("name"), str):
        return {"type": "function", "function": {"name": raw_choice["name"]}}
    if choice_type == "function":
        return raw_choice
    return None


def convert_messages(body: dict[str, Any]) -> list[dict[str, Any]]:
    messages: list[dict[str, Any]] = []
    system = body.get("system")
    if isinstance(system, str) and system.strip():
        messages.append({"role": "system", "content": system})
    elif isinstance(system, list):
        system_text = text_from_content(system)
        if system_text.strip():
            messages.append({"role": "system", "content": system_text})

    for message in body.get("messages", []):
        if not isinstance(message, dict):
            continue
        role = message.get("role")
        if role not in {"user", "assistant"}:
            role = "user"
        content = message.get("content", "")
        if not isinstance(content, list):
            append_text_message(messages, role, text_from_content(content))
            continue

        if role == "assistant":
            text_parts: list[str] = []
            tool_calls: list[dict[str, Any]] = []
            for item in content:
                if not isinstance(item, dict):
                    if isinstance(item, str):
                        text_parts.append(item)
                    continue
                item_type = item.get("type")
                if item_type == "text" and isinstance(item.get("text"), str):
                    text_parts.append(item["text"])
                elif item_type == "tool_use" and isinstance(item.get("name"), str):
                    call_id = (
                        item.get("id")
                        if isinstance(item.get("id"), str)
                        else f"toolu_{uuid.uuid4().hex[:12]}"
                    )
                    tool_calls.append(
                        {
                            "id": call_id,
                            "type": "function",
                            "function": {
                                "name": item["name"],
                                "arguments": tool_arguments(item.get("input")),
                            },
                        }
                    )
            if text_parts or tool_calls:
                entry: dict[str, Any] = {
                    "role": "assistant",
                    "content": "\n".join(text_parts) if text_parts else None,
                }
                if tool_calls:
                    entry["tool_calls"] = tool_calls
                messages.append(entry)
            continue

        user_parts: list[str] = []
        for item in content:
            if not isinstance(item, dict):
                if isinstance(item, str):
                    user_parts.append(item)
                continue
            item_type = item.get("type")
            if item_type == "text" and isinstance(item.get("text"), str):
                user_parts.append(item["text"])
            elif item_type == "tool_result":
                append_text_message(messages, "user", "\n".join(user_parts))
                user_parts = []
                tool_use_id = item.get("tool_use_id")
                if isinstance(tool_use_id, str):
                    messages.append(
                        {
                            "role": "tool",
                            "tool_call_id": tool_use_id,
                            "content": text_from_content(item.get("content", "")),
                        }
                    )
        append_text_message(messages, "user", "\n".join(user_parts))
    return messages


def message_text_len(message: dict[str, Any]) -> int:
    content = message.get("content")
    return len(content) if isinstance(content, str) else 0


def trim_text_middle(text: str, max_chars: int) -> str:
    if max_chars <= 0:
        return ""
    if len(text) <= max_chars:
        return text
    marker = "\n\n[content compacted by local Huanxin proxy]\n\n"
    if max_chars <= len(marker):
        return marker[:max_chars]
    head_chars = max(0, (max_chars - len(marker)) // 3)
    tail_chars = max(0, max_chars - len(marker) - head_chars)
    return text[:head_chars] + marker + text[-tail_chars:]


def compact_messages(messages: list[dict[str, Any]], max_input_chars: int) -> list[dict[str, Any]]:
    if max_input_chars <= 0:
        return messages
    total = sum(message_text_len(message) for message in messages)
    if total <= max_input_chars:
        return messages

    compacted = [dict(message) for message in messages]
    system_budget = min(6000, max(1000, max_input_chars // 4))
    for message in compacted:
        if message.get("role") == "system" and isinstance(message.get("content"), str):
            message["content"] = trim_text_middle(message["content"], system_budget)

    while sum(message_text_len(message) for message in compacted) > max_input_chars:
        text_messages = [
            (index, message_text_len(message))
            for index, message in enumerate(compacted)
            if isinstance(message.get("content"), str) and message_text_len(message) > 1000
        ]
        if not text_messages:
            break
        index, current_len = max(text_messages, key=lambda item: item[1])
        overflow = sum(message_text_len(message) for message in compacted) - max_input_chars
        target_len = max(1000, current_len - max(overflow, current_len // 3))
        compacted[index]["content"] = trim_text_middle(compacted[index]["content"], target_len)
    return compacted


def request_text(body: dict[str, Any], max_chars: int = 12000) -> str:
    parts: list[str] = []
    system = body.get("system")
    if isinstance(system, str):
        parts.append(system)
    elif isinstance(system, list):
        parts.append(text_from_content(system))
    for message in body.get("messages", []):
        if not isinstance(message, dict):
            continue
        parts.append(text_from_content(message.get("content", "")))
        if sum(len(part) for part in parts) >= max_chars:
            break
    return "\n\n".join(part for part in parts if part)[-max_chars:]


def is_compaction_like_request(body: dict[str, Any]) -> bool:
    system = body.get("system")
    system_text = ""
    if isinstance(system, str):
        system_text = system
    elif isinstance(system, list):
        system_text = text_from_content(system)
    system_text = system_text.lower()
    strong_markers = (
        "compaction",
        "compact the conversation",
        "summarize the conversation",
        "older context",
        "preserve decisions",
        "conversation summary",
    )
    return any(marker in system_text for marker in strong_markers)


def is_compaction_upstream_failure(status: int, payload: dict[str, Any]) -> bool:
    if status not in {HTTPStatus.INTERNAL_SERVER_ERROR, HTTPStatus.BAD_GATEWAY}:
        return False
    error = payload.get("error")
    if isinstance(error, dict):
        message = str(error.get("message") or error)
        error_type = str(error.get("type") or "")
    else:
        message = str(error)
        error_type = ""
    message = message.lower()
    error_type = error_type.lower()
    return (
        "window limit" in message
        or "internal server error" in message
        or "remote end closed connection" in message
        or "upstream_connection_error" in error_type
    )


def local_compaction_response(
    server: ThreadingHTTPServer, body: dict[str, Any], upstream: dict[str, Any]
) -> dict[str, Any]:
    source = request_text(body, 10000)
    fallback_note = (
        "Local compaction fallback: the Huanxin GLM 5.2 upstream rejected the "
        "compaction request, so this proxy preserved a trimmed context excerpt "
        "instead of returning an API 500."
    )
    excerpt = trim_text_middle(source, 7000)
    text = f"{fallback_note}\n\nPreserved context excerpt:\n{excerpt}".strip()
    return {
        "id": f"msg_{uuid.uuid4().hex}",
        "type": "message",
        "role": "assistant",
        "model": body.get("model") or server.model_name,  # type: ignore[attr-defined]
        "content": [{"type": "text", "text": text}],
        "stop_reason": "end_turn",
        "stop_sequence": None,
        "usage": {"input_tokens": 0, "output_tokens": 0},
    }


def _is_expired_cert_error(exc: BaseException) -> bool:
    reason = getattr(exc, "reason", exc)
    if isinstance(reason, ssl.SSLCertVerificationError):
        if getattr(reason, "verify_code", None) == _CERT_EXPIRED_CODE:
            return True
    return "certificate has expired" in str(exc).lower()


def _curl_upstream(
    request: urllib.request.Request, insecure: bool, timeout: int
) -> tuple[int, str, str]:
    """Perform the upstream POST with /usr/bin/curl instead of urllib.

    EVIDENCE (2026-09-14): the aihuanxin.cn gateway stopped accepting Python's
    OpenSSL/TLS stack. The handshake completes, then the server RESETS the
    connection, so urllib surfaces
    `<urlopen error [SSL: UNEXPECTED_EOF_WHILE_READING]>` for every call while
    `curl` to the same URL with the same JWT headers gets a normal response.
    This proxy is the Mac end of the judge bridge, so every judge call failed
    and pass_rate was structurally 0. curl is the transport now; a curl failure
    is raised loudly (no silent urllib fallback) so it still maps to the
    existing upstream_connection_error / retry path.
    """
    fd, body_path = tempfile.mkstemp(prefix="huanxin_upstream_", suffix=".body")
    os.close(fd)
    # EVIDENCE (2026-09-22): the aihuanxin.cn gateway rejects chunked
    # transfer-encoding (curl stdin upload) with HTTP 500 -> its 404 HTML page
    # ("subscription route not found"). Identical body sent with a fixed
    # Content-Length (curl -d/--data-binary @file) returns 200. Bisected A/B:
    # stdin 500/500/500/500 vs -d 200/200/200. Write the request body to a
    # temp file and pass --data-binary @file so curl sizes it exactly.
    fd_req, req_path = tempfile.mkstemp(prefix="huanxin_request_", suffix=".json")
    try:
        os.write(fd_req, request.data or b"")
        os.close(fd_req)
    except BaseException:
        try:
            os.close(fd_req)
        except OSError:
            pass
        raise
    try:
        cmd = [
            "/usr/bin/curl",
            "-sS",
            "-X",
            request.get_method() or "POST",
            "--max-time",
            str(timeout),
            "-o",
            body_path,
            "-w",
            "%{http_code}\n%{content_type}",
        ]
        if insecure:
            cmd.append("-k")
        # request.headers is exactly what urllib would have put on the wire
        # (Authorization, Content-type, X-ca-key appcode JWT, ...).
        for name, value in request.headers.items():
            cmd += ["-H", "%s: %s" % (name, value)]
        cmd.append(request.full_url)
        cmd += ["--data-binary", "@" + req_path]
        try:
            proc = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout + 10,
            )
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError("curl upstream timed out after %ss: %r" % (timeout, exc))
        if proc.returncode != 0:
            raise RuntimeError(
                "curl upstream failed rc=%s: %s"
                % (proc.returncode, proc.stderr.decode("utf-8", "replace").strip())
            )
        with open(body_path, "rb") as handle:
            raw = handle.read()
        head = proc.stdout.decode("utf-8", "replace").split("\n", 1)
        status = int(head[0].strip()) if head[0].strip().isdigit() else 0
        content_type = head[1].strip() if len(head) > 1 else ""
        return status, raw.decode("utf-8", "replace"), content_type
    finally:
        try:
            os.unlink(req_path)
        except OSError:
            pass
        try:
            os.unlink(body_path)
        except OSError:
            pass


def _perform_upstream(
    request: urllib.request.Request, context: ssl.SSLContext
) -> tuple[int, dict[str, Any]]:
    timeout = int(os.environ.get("HUANXIN_GLM52_UPSTREAM_TIMEOUT", "60"))
    insecure = bool(context is not None and getattr(context, "verify_mode", None) == ssl.CERT_NONE)
    status, response_body, content_type = _curl_upstream(request, insecure, timeout)
    if status >= 400:
        # Preserve urllib's contract: >=400 raised HTTPError so the existing
        # route-error / retry handling downstream is unchanged.
        raise urllib.error.HTTPError(
            request.full_url,
            status,
            "upstream HTTP %s" % status,
            {},
            io.BytesIO(response_body.encode("utf-8")),
        )
    if "text/event-stream" in content_type or response_body.lstrip().startswith("data:"):
        return status, parse_chat_stream(response_body)
    return status, json.loads(response_body)


def merge_tool_call_deltas(message: dict[str, Any], deltas: list[Any]) -> None:
    existing = message.get("tool_calls")
    if not isinstance(existing, list):
        existing = []
        message["tool_calls"] = existing
    for raw in deltas:
        if not isinstance(raw, dict):
            continue
        index = raw.get("index")
        if not isinstance(index, int) or index < 0:
            index = max(0, len(existing) - 1)
        while len(existing) <= index:
            existing.append(
                {"id": None, "type": "function", "function": {"name": "", "arguments": ""}}
            )
        entry = existing[index]
        call_id = raw.get("id")
        if isinstance(call_id, str) and call_id:
            entry["id"] = call_id
        if isinstance(raw.get("type"), str) and raw["type"]:
            entry["type"] = raw["type"]
        function = raw.get("function")
        if isinstance(function, dict):
            entry_fn = entry.setdefault("function", {"name": "", "arguments": ""})
            name = function.get("name")
            if isinstance(name, str) and name:
                entry_fn["name"] = name
            arguments = function.get("arguments")
            if isinstance(arguments, str):
                entry_fn["arguments"] = str(entry_fn.get("arguments") or "") + arguments


def merge_delta(message: dict[str, Any], delta: dict[str, Any]) -> None:
    content = delta.get("content")
    if isinstance(content, str):
        message["content"] = str(message.get("content") or "") + content
    for key in ("reasoning", "reasoning_content"):
        value = delta.get(key)
        if isinstance(value, str):
            message[key] = str(message.get(key) or "") + value
    tool_calls = delta.get("tool_calls")
    if isinstance(tool_calls, list) and tool_calls:
        merge_tool_call_deltas(message, tool_calls)


def parse_chat_stream(stream_body: str) -> dict[str, Any]:
    response: dict[str, Any] = {
        "id": f"chatcmpl_{uuid.uuid4().hex}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": "glm5.2",
        "choices": [
            {"index": 0, "message": {"role": "assistant", "content": ""}, "finish_reason": "stop"}
        ],
    }
    message = response["choices"][0]["message"]
    for line in stream_body.splitlines():
        line = line.strip()
        if not line.startswith("data:"):
            continue
        data = line.removeprefix("data:").strip()
        if not data or data == "[DONE]":
            continue
        try:
            chunk = json.loads(data)
        except Exception:
            continue
        if isinstance(chunk.get("id"), str):
            response["id"] = chunk["id"]
        if isinstance(chunk.get("created"), int):
            response["created"] = chunk["created"]
        if isinstance(chunk.get("model"), str):
            response["model"] = chunk["model"]
        choices = chunk.get("choices")
        if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
            continue
        delta = choices[0].get("delta")
        if isinstance(delta, dict):
            merge_delta(message, delta)
        finish_reason = choices[0].get("finish_reason")
        if isinstance(finish_reason, str):
            response["choices"][0]["finish_reason"] = finish_reason
        usage = chunk.get("usage")
        if isinstance(usage, dict):
            response["usage"] = usage
    return response


def server_is_glm52(server: ThreadingHTTPServer) -> bool:
    return str(getattr(server, "model_name", "")).lower() in {"glm5.2", "glm-5.2"}


def build_upstream_body(
    server: ThreadingHTTPServer, body: dict[str, Any], force_stream: bool | None = None
) -> dict[str, Any] | None:
    messages = compact_messages(
        convert_messages(body), int(getattr(server, "max_input_chars", 24000))
    )
    if not messages:
        return None

    is_glm52 = server_is_glm52(server)
    upstream_body: dict[str, Any] = {
        "messages": messages,
        "stream": is_glm52 if force_stream is None else force_stream,
    }
    # Always include the model field in the upstream body. Some OpenAI-compatible
    # upstreams (notably CMRI dev.cmri.cn/icoder) return HTTP 500
    # "服务器端错误，请稍后再试" when the model field is absent, even though the
    # proxy was launched with --model-name. Prefer the client-supplied model
    # (body["model"]) when present; otherwise fall back to server.model_name.
    # The local alias "glm5.2" maps to a provider-specific upstream model id.
    # Default to the old dev.cmri.cn id ("glm-5.2") for backward compatibility;
    # the cmri provider on 172.23.31.2 overrides this via
    # HUANXIN_GLM52_UPSTREAM_MODEL (set to "glm5.2" in cmri.env).
    upstream_model = body.get("model") or getattr(server, "model_name", "")
    if isinstance(upstream_model, str) and upstream_model.lower() == "glm5.2":
        upstream_model = os.environ.get("HUANXIN_GLM52_UPSTREAM_MODEL", "glm-5.2")
    if isinstance(upstream_model, str) and upstream_model.lower() == "dp4":
        upstream_model = os.environ.get("HUANXIN_DP4_UPSTREAM_MODEL", upstream_model)
    if upstream_model:
        upstream_body["model"] = upstream_model
    send_reasoning_params = (
        os.environ.get("HUANXIN_GLM52_SEND_REASONING_PARAMS", "1").strip().lower() in _TRUTHY
    )
    if is_glm52 and send_reasoning_params:
        upstream_body["thinking"] = {"type": "enabled"}
        upstream_body["reasoning_effort"] = "max"
    tools = convert_tools(body.get("tools"))
    if tools:
        upstream_body["tools"] = tools
        tool_choice = convert_tool_choice(body.get("tool_choice"))
        if tool_choice is not None:
            upstream_body["tool_choice"] = tool_choice
    if is_glm52:
        # GLM 5.2's context window (~131072) is shared between the prompt and the
        # generated output. Forcing a huge max_tokens leaves no room for the prompt
        # once the conversation grows, so the upstream returns HTTP 500
        # "Window limit exceeded" and Claude Code then hangs in retry backoff. Size
        # the output cap to fit the remaining window instead (respecting the client's
        # requested max_tokens). This does NOT touch GLM's "full power" reasoning
        # (thinking + reasoning_effort=max stay enabled above).
        window = int(os.environ.get("HUANXIN_GLM52_CONTEXT_WINDOW", "131072"))
        safety = int(os.environ.get("HUANXIN_GLM52_WINDOW_SAFETY", "8192"))
        default_out = int(os.environ.get("HUANXIN_GLM52_MAX_TOKENS", "32000"))
        requested = (
            body["max_tokens"]
            if isinstance(body.get("max_tokens"), int) and body["max_tokens"] > 0
            else default_out
        )
        # Account for everything that consumes the upstream context window:
        # message text content, tool-call argument JSON (each tool_call's
        # function.arguments string is serialized into the prompt), and the
        # tool definitions themselves (name + description + JSON schema). The
        # previous estimate only counted string `content` and missed all of
        # these, which over-estimated the remaining room and caused
        # "Window limit exceeded" 500s on tool-heavy Claude Code sessions.
        prompt_chars = 0
        for m in upstream_body["messages"]:
            content = m.get("content")
            if isinstance(content, str):
                prompt_chars += len(content)
            tool_calls = m.get("tool_calls")
            if isinstance(tool_calls, list):
                for tc in tool_calls:
                    if not isinstance(tc, dict):
                        continue
                    fn = tc.get("function")
                    if not isinstance(fn, dict):
                        continue
                    prompt_chars += len(fn.get("name") or "")
                    prompt_chars += len(fn.get("arguments") or "")
        tools = upstream_body.get("tools")
        if isinstance(tools, list):
            for tool in tools:
                if not isinstance(tool, dict):
                    continue
                fn = tool.get("function") if isinstance(tool.get("function"), dict) else tool
                prompt_chars += len(fn.get("name") or "")
                prompt_chars += len(fn.get("description") or "")
                schema = fn.get("parameters") or fn.get("input_schema")
                if isinstance(schema, dict):
                    prompt_chars += len(json.dumps(schema, separators=(",", ":")))
        # ~3.5 chars/token is a safer estimate than //3 for mixed code/text;
        # tool schemas and JSON arguments tokenize closer to 3 chars/token, so
        # be conservative to avoid overshooting the window.
        prompt_tokens_est = int(prompt_chars / 3.5) + 16
        room = window - prompt_tokens_est - safety
        upstream_body["max_tokens"] = max(1024, min(requested, room))
    elif isinstance(body.get("max_tokens"), int):
        upstream_body["max_tokens"] = body["max_tokens"]
    if isinstance(body.get("temperature"), (int, float)):
        upstream_body["temperature"] = body["temperature"]
    if isinstance(body.get("top_p"), (int, float)):
        upstream_body["top_p"] = body["top_p"]
    # Pass through logprobs requests so callers can retrieve teacher logits
    if body.get("logprobs") is not None:
        upstream_body["logprobs"] = body["logprobs"]
    if body.get("top_logprobs") is not None:
        upstream_body["top_logprobs"] = body["top_logprobs"]
    return upstream_body


def build_upstream_request(
    server: ThreadingHTTPServer, upstream_body: dict[str, Any]
) -> urllib.request.Request:
    headers = {
        "Authorization": server.upstream_token,  # type: ignore[attr-defined]
        "Content-Type": "application/json",
    }
    appcode = getattr(server, "appcode", "") or ""
    if appcode:
        # qdlake API-gateway subscriptions (e.g. deepseekv4_master) require the
        # appcode JWT in X-Ca-Key; without it the gateway returns its 404 page.
        headers["X-Ca-Key"] = appcode
    return urllib.request.Request(
        server.upstream_url,  # type: ignore[attr-defined]
        data=json.dumps(upstream_body).encode("utf-8"),
        headers=headers,
        method="POST",
    )


def upstream_context(server: ThreadingHTTPServer) -> tuple[ssl.SSLContext, bool]:
    insecure = bool(getattr(server, "insecure", False))
    context = server.insecure_context if insecure else server.verify_context  # type: ignore[attr-defined]
    return context, insecure


def is_retryable_payload(status: int, payload: dict[str, Any]) -> bool:
    """The Huanxin GLM upstream intermittently returns HTTP 500 (often
    '{"error": "Window limit exceeded"}' or a bare nginx 500) for perfectly valid
    requests. Empirically the same request succeeds on retry ~70% of the time, so we
    absorb these blips here instead of letting Claude Code surface an error / hang.
    """
    # Transient upstream throttles that must be retried even though they are < 500:
    #   * 444 = nginx "connection closed without response" (gateway drops the request
    #           under load / WAF) -- surfaces to Claude as "HTTP Error 444".
    #   * 429 = too many requests, 408 = request timeout.
    # These share the same root cause as the 500 "Window limit exceeded" blips and
    # succeed on retry, so absorb them here instead of erroring the turn.
    if status in {408, 429, 444}:
        return True
    error = payload.get("error")
    if isinstance(error, dict) and error.get("type") == "upstream_route_error":
        return False
    if status < 500:
        return False
    text = json.dumps(error) if not isinstance(error, str) else error
    text = text.lower()
    return (
        "window limit" in text
        or "internal server error" in text
        or "upstream_connection_error" in text
        or "upstream_http_error" in text
        or "remote end closed" in text
        or "bad gateway" in text
        or "temporarily unavailable" in text
        or status in {500, 502, 503, 504}
    )


def _retry_config() -> tuple[int, float]:
    tries = max(1, int(os.environ.get("HUANXIN_GLM52_RETRIES", "6")))
    base = float(os.environ.get("HUANXIN_GLM52_RETRY_BASE", "0.8"))
    return tries, base


# --- Rate limiter & circuit breaker for Huanxin upstream robustness ------------
#
# The Huanxin GLM 5.2 ingress enforces a sliding-window rate limit that surfaces
# as HTTP 500 '{"error": "Window limit exceeded"}'. Rapid sequential requests
# (e.g. when future-code sends system prompt + tool schemas + user message in
# quick succession) trip the limit and every subsequent call fails until the
# window resets. We space out upstream calls globally and use a longer backoff
# for rate-limit errors specifically.

import threading as _threading
import time as _time_mod

# Global minimum spacing between upstream calls (seconds). Tune via env.
_UPSTREAM_MIN_SPACING = float(os.environ.get("HUANXIN_GLM52_MIN_SPACING", "0.8"))
_last_upstream_call_at = 0.0
_spacing_lock = _threading.Lock()


def _reserve_upstream_slot() -> None:
    """Block until at least _UPSTREAM_MIN_SPACING seconds have passed since the
    last upstream call. Serialises requests across threads so concurrent proxy
    clients don't burst the upstream rate limit. Maximum wait is capped to
    avoid deadlock when a prior request hangs."""
    global _last_upstream_call_at
    max_wait = float(os.environ.get("HUANXIN_GLM52_SPACING_MAX_WAIT", "10.0"))
    with _spacing_lock:
        now = _time_mod.monotonic()
        wait = _UPSTREAM_MIN_SPACING - (now - _last_upstream_call_at)
        if wait > 0:
            _time_mod.sleep(min(wait, max_wait))
        _last_upstream_call_at = _time_mod.monotonic()


def _is_rate_limit_error(status: int, payload: dict[str, Any]) -> bool:
    """Detect Huanxin's 'Window limit exceeded' rate-limit response."""
    if status != 500:
        return False
    error = payload.get("error")
    text = json.dumps(error) if not isinstance(error, str) else error
    return "window limit" in text.lower()


# Circuit breaker: after N consecutive rate-limit / connection errors, fail
# fast for a cooldown period so future-code doesn't waste minutes per request.
_CB_FAILURE_THRESHOLD = int(os.environ.get("HUANXIN_GLM52_CB_THRESHOLD", "5"))
_CB_COOLDOWN = float(os.environ.get("HUANXIN_GLM52_CB_COOLDOWN", "15.0"))
_cb_consecutive_failures = 0
_cb_open_until = 0.0
_cb_lock = _threading.Lock()


def _circuit_check() -> tuple[bool, float]:
    """Returns (is_open, seconds_remaining)."""
    with _cb_lock:
        if _cb_open_until > _time_mod.monotonic():
            return True, _cb_open_until - _time_mod.monotonic()
        return False, 0.0


def _circuit_record_failure() -> None:
    global _cb_consecutive_failures, _cb_open_until
    with _cb_lock:
        _cb_consecutive_failures += 1
        if _cb_consecutive_failures >= _CB_FAILURE_THRESHOLD:
            _cb_open_until = _time_mod.monotonic() + _CB_COOLDOWN
            debug_log(
                "circuit breaker opened for %.1fs after %d consecutive failures"
                % (_CB_COOLDOWN, _cb_consecutive_failures)
            )


def _circuit_record_success() -> None:
    global _cb_consecutive_failures
    with _cb_lock:
        _cb_consecutive_failures = 0


def upstream_chat(server: ThreadingHTTPServer, body: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    upstream_body = build_upstream_body(server, body)
    if upstream_body is None:
        return HTTPStatus.BAD_REQUEST, {
            "error": {"message": "missing messages", "type": "invalid_request_error"}
        }

    # Fail fast if the circuit breaker is open.
    cb_open, cb_wait = _circuit_check()
    if cb_open:
        return HTTPStatus.SERVICE_UNAVAILABLE, {
            "error": {
                "message": "upstream circuit breaker open, retry in %.1fs" % cb_wait,
                "type": "upstream_circuit_open",
            }
        }

    request = build_upstream_request(server, upstream_body)

    tries, base = _retry_config()
    status, payload = (
        HTTPStatus.BAD_GATEWAY,
        {"error": {"message": "no attempt", "type": "upstream_connection_error"}},
    )
    for attempt in range(tries):
        _reserve_upstream_slot()
        status, payload = _upstream_chat_once(server, request)
        if status < 400:
            _circuit_record_success()
            return status, payload
        if not is_retryable_payload(status, payload):
            _circuit_record_failure()
            return status, payload
        # Rate-limit errors need a longer backoff than transient 500s.
        if _is_rate_limit_error(status, payload):
            delay = min(base * (2**attempt) * 3.0, 30.0)
        else:
            delay = min(base * (2**attempt), 8.0)
        if attempt + 1 < tries:
            debug_log(
                "retryable upstream status=%s attempt=%s/%s sleeping=%.1fs"
                % (status, attempt + 1, tries, delay)
            )
            time.sleep(delay)
        else:
            _circuit_record_failure()
    return status, payload


def _upstream_chat_once(
    server: ThreadingHTTPServer, request: urllib.request.Request
) -> tuple[int, dict[str, Any]]:
    insecure = bool(getattr(server, "insecure", False))
    context = server.insecure_context if insecure else server.verify_context  # type: ignore[attr-defined]
    try:
        return _perform_upstream(request, context)
    except urllib.error.HTTPError as exc:
        raw_body = exc.read().decode("utf-8", "replace")
        try:
            payload = json.loads(raw_body)
        except Exception:
            message = "Huanxin inference gateway returned HTTP %s" % exc.code
            if "404 -" in raw_body or "页面未找到" in raw_body:
                message += ": subscription route not found"
            payload = {"error": {"message": message, "type": "upstream_route_error"}}
        return exc.code, payload
    except Exception as exc:
        # The upstream's own TLS certificate has expired (server-side issue). Retry once
        # without verification so the user stays unblocked; this reverts to full
        # verification automatically once the upstream renews its certificate.
        if not insecure and _is_expired_cert_error(exc):
            sys.stderr.write(
                "[huanxin-proxy] WARNING: upstream TLS certificate verification failed "
                "(certificate has expired); retrying once without verification.\n"
            )
            sys.stderr.flush()
            try:
                return _perform_upstream(request, server.insecure_context)  # type: ignore[attr-defined]
            except urllib.error.HTTPError as exc2:
                try:
                    payload = json.loads(exc2.read().decode("utf-8"))
                except Exception:
                    payload = {"error": {"message": str(exc2), "type": "upstream_http_error"}}
                return exc2.code, payload
            except Exception as exc2:
                exc = exc2
        return HTTPStatus.BAD_GATEWAY, {
            "error": {"message": str(exc), "type": "upstream_connection_error"}
        }


def anthropic_response(
    server: ThreadingHTTPServer, body: dict[str, Any], upstream: dict[str, Any]
) -> dict[str, Any]:
    if not isinstance(upstream, dict):
        upstream = {}
    choice: dict[str, Any] = {}
    choices = upstream.get("choices")
    if isinstance(choices, list) and choices and isinstance(choices[0], dict):
        choice = choices[0]
    message = choice.get("message") if isinstance(choice.get("message"), dict) else {}
    content_blocks: list[dict[str, Any]] = []
    tool_calls = message.get("tool_calls")
    if isinstance(tool_calls, list):
        for tool_call in tool_calls:
            if not isinstance(tool_call, dict):
                continue
            function = tool_call.get("function")
            if not isinstance(function, dict):
                continue
            name = function.get("name")
            if not isinstance(name, str) or not name:
                continue
            call_id = (
                tool_call.get("id")
                if isinstance(tool_call.get("id"), str)
                else f"toolu_{uuid.uuid4().hex[:12]}"
            )
            content_blocks.append(
                {
                    "type": "tool_use",
                    "id": call_id,
                    "name": name,
                    "input": parse_tool_input(function.get("arguments")),
                }
            )

    text = message.get("content") if isinstance(message.get("content"), str) else ""
    # Expose GLM 5.2's reasoning as an Anthropic "thinking" content block so
    # non-streaming responses also surface the model's thinking. Keep the
    # fallback of promoting reasoning to visible text only when there is no
    # other content at all (preserves prior behaviour for empty-answer turns).
    reasoning_text = ""
    if isinstance(message.get("reasoning_content"), str):
        reasoning_text = message["reasoning_content"]
    elif isinstance(message.get("reasoning"), str):
        reasoning_text = message["reasoning"]
    if reasoning_text:
        content_blocks.insert(0, {"type": "thinking", "thinking": reasoning_text, "signature": ""})
    if not text and not content_blocks and reasoning_text:
        content_blocks.append({"type": "text", "text": reasoning_text})
    if text:
        content_blocks.insert(0 if not reasoning_text else 1, {"type": "text", "text": text})
    usage = upstream.get("usage") if isinstance(upstream.get("usage"), dict) else {}
    stop_reason = (
        "tool_use"
        if any(block.get("type") == "tool_use" for block in content_blocks)
        else "end_turn"
    )
    result = {
        "id": upstream.get("id") or f"msg_{uuid.uuid4().hex}",
        "type": "message",
        "role": "assistant",
        "model": body.get("model") or server.model_name,  # type: ignore[attr-defined]
        "content": content_blocks,
        "stop_reason": stop_reason,
        "stop_sequence": None,
        "usage": {
            "input_tokens": int(usage.get("prompt_tokens") or usage.get("input_tokens") or 0),
            "output_tokens": int(usage.get("completion_tokens") or usage.get("output_tokens") or 0),
        },
    }
    return result


class AnthropicStreamWriter:
    """Translate an OpenAI-style SSE token stream into a live Anthropic Messages SSE stream.

    GLM 5.2 "full power" spends a long time emitting reasoning_content before any
    visible answer token. We keep the client connection alive with periodic ping
    events during that phase so Claude Code never sees a long silent gap (which it
    treats as a dropped/failed request on the next turn).
    """

    def __init__(
        self,
        handler: BaseHTTPRequestHandler,
        msg_id: str,
        model: str,
        tool_names: list[str] | None = None,
    ) -> None:
        self.handler = handler
        self.msg_id = msg_id
        self.model = model
        self.tool_names = list(tool_names) if tool_names else []
        self.next_index = 0
        self.text_index: int | None = None
        self.thinking_index: int | None = None
        self.tool_blocks: dict[int, dict[str, Any]] = {}
        self.reasoning_buffer: list[str] = []
        self.any_output = False
        self.finish_reason: str | None = None
        self.usage: dict[str, Any] | None = None
        self.last_write = time.time()

    def _send(self, event_type: str, data: dict[str, Any]) -> None:
        payload = dict(data)
        payload["type"] = event_type
        blob = (
            f"event: {event_type}\ndata: {json.dumps(payload, separators=(',', ':'))}\n\n".encode()
        )
        self.handler.wfile.write(blob)
        self.handler.wfile.flush()
        self.last_write = time.time()

    def start(self) -> None:
        self._send(
            "message_start",
            {
                "message": {
                    "id": self.msg_id,
                    "type": "message",
                    "role": "assistant",
                    "model": self.model,
                    "content": [],
                    "stop_reason": None,
                    "stop_sequence": None,
                    "usage": {"input_tokens": 0, "output_tokens": 0},
                }
            },
        )
        self._send("ping", {})

    def maybe_ping(self, interval: float = 5.0) -> None:
        if time.time() - self.last_write >= interval:
            self._send("ping", {})

    def _ensure_text_open(self) -> None:
        self._close_thinking()
        if self.text_index is None:
            self.text_index = self.next_index
            self.next_index += 1
            self._send(
                "content_block_start",
                {"index": self.text_index, "content_block": {"type": "text", "text": ""}},
            )

    def _close_text(self) -> None:
        if self.text_index is not None:
            self._send("content_block_stop", {"index": self.text_index})
            self.text_index = None

    def _ensure_thinking_open(self) -> None:
        if self.thinking_index is None:
            self.thinking_index = self.next_index
            self.next_index += 1
            self._send(
                "content_block_start",
                {
                    "index": self.thinking_index,
                    "content_block": {"type": "thinking", "thinking": "", "signature": ""},
                },
            )

    def _close_thinking(self) -> None:
        if self.thinking_index is not None:
            self._send("content_block_stop", {"index": self.thinking_index})
            self.thinking_index = None

    def add_text(self, text: str) -> None:
        if not text:
            return
        self._ensure_text_open()
        self.any_output = True
        self._send(
            "content_block_delta",
            {"index": self.text_index, "delta": {"type": "text_delta", "text": text}},
        )

    def add_reasoning(self, text: str) -> None:
        # Stream GLM 5.2's reasoning_content live as an Anthropic "thinking"
        # content block so Claude Code surfaces the model's thinking (collapsible
        # section) instead of silently discarding it. The reasoning is also
        # buffered so finish() can fall back to visible text if GLM produces
        # only reasoning and no answer/tool_call (rare edge case where we want
        # the user to still see something readable in non-thinking-aware UIs).
        if not text:
            return
        self.reasoning_buffer.append(text)
        self._ensure_thinking_open()
        self._send(
            "content_block_delta",
            {"index": self.thinking_index, "delta": {"type": "thinking_delta", "thinking": text}},
        )
        # Treat streamed thinking as output so the finish() fallback below does
        # not duplicate the reasoning into a text block when text/tools follow.
        self.any_output = True

    def _start_tool_block(self, block: dict[str, Any]) -> None:
        self._close_thinking()
        self._close_text()
        block["anthropic_index"] = self.next_index
        self.next_index += 1
        block["started"] = True
        self._send(
            "content_block_start",
            {
                "index": block["anthropic_index"],
                "content_block": {
                    "type": "tool_use",
                    "id": block["id"],
                    "name": block["name"],
                    "input": {},
                },
            },
        )

    def add_tool_calls(self, deltas: list[Any]) -> None:
        for raw in deltas:
            if not isinstance(raw, dict):
                continue
            oai_index = raw.get("index")
            if not isinstance(oai_index, int) or oai_index < 0:
                oai_index = len(self.tool_blocks)
            block = self.tool_blocks.get(oai_index)
            if block is None:
                block = {
                    "anthropic_index": None,
                    "id": raw.get("id")
                    if isinstance(raw.get("id"), str) and raw.get("id")
                    else f"toolu_{uuid.uuid4().hex[:12]}",
                    "name": "",
                    "started": False,
                }
                self.tool_blocks[oai_index] = block
            call_id = raw.get("id")
            if isinstance(call_id, str) and call_id:
                block["id"] = call_id
            function = raw.get("function")
            if not isinstance(function, dict):
                continue
            name = function.get("name")
            if isinstance(name, str) and name:
                block["name"] = name
            if not block["started"] and block["name"]:
                self._start_tool_block(block)
            arguments = function.get("arguments")
            if isinstance(arguments, str) and arguments and block["started"]:
                self.any_output = True
                self._send(
                    "content_block_delta",
                    {
                        "index": block["anthropic_index"],
                        "delta": {"type": "input_json_delta", "partial_json": arguments},
                    },
                )

    def finish(self) -> None:
        # Close any open thinking block first. If GLM produced only reasoning
        # (no text, no tool calls), ensure at least an empty text block exists
        # so the Anthropic message shape is valid and Claude Code doesn't render
        # an empty turn. The reasoning itself is already surfaced via the
        # thinking block streamed in add_reasoning().
        self._close_thinking()
        # GLM 5.2's streaming tool_call deltas omit the function name (they only
        # carry {"index":0,"function":{"arguments":""}}). If the upstream signalled
        # finish_reason="tool_calls" but we never started a tool block (because
        # add_tool_calls waits for a name), resolve the name from the request's
        # tool list and synthesize the tool_use block so Claude Code actually
        # receives the tool call instead of a silent end_turn.
        if self.finish_reason == "tool_calls":
            for oai_index, block in self.tool_blocks.items():
                if block["started"]:
                    continue
                if not block["name"] and self.tool_names:
                    # If only one tool was offered, GLM's choice is unambiguous.
                    # With multiple tools we fall back to the first offered tool
                    # (GLM gives us no way to identify which one it picked in the
                    # streaming delta; the non-streaming path carries the name).
                    if len(self.tool_names) == 1:
                        block["name"] = self.tool_names[0]
                    else:
                        block["name"] = self.tool_names[0]
                if block["name"]:
                    self._start_tool_block(block)
                    # Emit a minimal empty input so Claude Code sees a valid
                    # tool_use block even when GLM sent no argument tokens.
                    self._send(
                        "content_block_delta",
                        {
                            "index": block["anthropic_index"],
                            "delta": {"type": "input_json_delta", "partial_json": "{}"},
                        },
                    )
                    self.any_output = True
        if not self.any_output:
            self._ensure_text_open()
            self.any_output = True
        self._close_text()
        for block in self.tool_blocks.values():
            if block["started"] and block["anthropic_index"] is not None:
                self._send("content_block_stop", {"index": block["anthropic_index"]})
        has_tool = any(block["started"] for block in self.tool_blocks.values())
        stop_reason = "tool_use" if has_tool else "end_turn"
        if self.finish_reason == "length" and not has_tool:
            stop_reason = "max_tokens"
        usage = self.usage or {}
        self._send(
            "message_delta",
            {
                "delta": {"stop_reason": stop_reason, "stop_sequence": None},
                "usage": {
                    "input_tokens": int(
                        usage.get("prompt_tokens") or usage.get("input_tokens") or 0
                    ),
                    "output_tokens": int(
                        usage.get("completion_tokens") or usage.get("output_tokens") or 0
                    ),
                },
            },
        )
        self._send("message_stop", {})


def feed_stream_line(writer: AnthropicStreamWriter, line: str) -> None:
    line = line.strip()
    if not line.startswith("data:"):
        return
    data = line[len("data:") :].strip()
    if not data or data == "[DONE]":
        return
    try:
        chunk = json.loads(data)
    except Exception:
        return
    usage = chunk.get("usage")
    if isinstance(usage, dict):
        writer.usage = usage
    choices = chunk.get("choices")
    if not isinstance(choices, list) or not choices or not isinstance(choices[0], dict):
        return
    choice = choices[0]
    delta = choice.get("delta")
    if isinstance(delta, dict):
        content = delta.get("content")
        if isinstance(content, str):
            writer.add_text(content)
        for key in ("reasoning", "reasoning_content"):
            value = delta.get(key)
            if isinstance(value, str):
                writer.add_reasoning(value)
        tool_calls = delta.get("tool_calls")
        if isinstance(tool_calls, list) and tool_calls:
            writer.add_tool_calls(tool_calls)
    finish_reason = choice.get("finish_reason")
    if isinstance(finish_reason, str):
        writer.finish_reason = finish_reason


class Handler(BaseHTTPRequestHandler):
    server_version = "claude-huanxin-anthropic-proxy/0.1"

    def do_GET(self) -> None:  # noqa: N802
        path = urlparse(self.path).path
        if path in {"/", "/health", "/healthz"}:
            write_json(self, HTTPStatus.OK, {"ok": True, "model": self.server.model_name})  # type: ignore[attr-defined]
            return
        write_json(
            self,
            HTTPStatus.NOT_FOUND,
            {"error": {"message": "not found", "type": "not_found_error"}},
        )

    def do_POST(self) -> None:  # noqa: N802
        path = urlparse(self.path).path
        if path not in {"/v1/messages", "/messages"}:
            write_json(
                self,
                HTTPStatus.NOT_FOUND,
                {"error": {"message": "not found", "type": "not_found_error"}},
            )
            return
        try:
            length = int(self.headers.get("Content-Length") or "0")
            body = json.loads(self.rfile.read(length).decode("utf-8"))
        except Exception:
            write_json(
                self,
                HTTPStatus.BAD_REQUEST,
                {"error": {"message": "invalid JSON", "type": "invalid_request_error"}},
            )
            return

        # Live streaming path: forward tokens to the client as they arrive and keep the
        # connection alive with pings during GLM's long "thinking" phase. Compaction
        # requests stay on the buffered path so their upstream-failure fallback works.
        if body.get("stream") and not is_compaction_like_request(body):
            try:
                if self.stream_live(self.server, body):  # type: ignore[arg-type]
                    return
            except (BrokenPipeError, ConnectionResetError):
                return
            except Exception as exc:  # pragma: no cover - defensive
                debug_log("stream_live failed, falling back to buffered: %r" % exc)

        status, upstream = upstream_chat(self.server, body)  # type: ignore[arg-type]
        if _DEBUG_LOG_PATH:
            debug_log(
                "POST model=%s stream=%s n_msgs=%s tools=%s status=%s upstream_keys=%s"
                % (
                    body.get("model"),
                    bool(body.get("stream")),
                    len(body.get("messages") or []),
                    len(body.get("tools") or []),
                    status,
                    list(upstream.keys()),
                )
            )
            if status >= 400:
                debug_log("  upstream_error=%s" % json.dumps(upstream)[:800])
        if status >= 400:
            if is_compaction_like_request(body) and is_compaction_upstream_failure(
                status, upstream
            ):
                response = local_compaction_response(self.server, body, upstream)  # type: ignore[arg-type]
                if body.get("stream"):
                    self.write_stream(response)
                else:
                    write_json(self, HTTPStatus.OK, response)
                return
            write_json(self, status, upstream)
            return
        response = anthropic_response(self.server, body, upstream)  # type: ignore[arg-type]
        # Defensive: filter out any None/non-dict blocks that could sneak in from
        # a malformed upstream response (root cause of the Jul-23 NoneType crash
        # at this exact line). Also guarantees the write_stream loop below is safe.
        _content = response.get("content")
        if isinstance(_content, list):
            response["content"] = [b for b in _content if isinstance(b, dict)]
        if _DEBUG_LOG_PATH:
            debug_log(
                "  -> blocks=%s stop=%s"
                % (
                    [b.get("type") for b in response.get("content") or []],
                    response.get("stop_reason"),
                )
            )
        if body.get("stream"):
            self.write_stream(response)
        else:
            write_json(self, HTTPStatus.OK, response)

    def stream_live(self, server: ThreadingHTTPServer, body: dict[str, Any]) -> bool:
        """Stream the upstream response to the client in real time.

        Returns True if the response was handled (headers sent). Returns False only if
        the upstream could not be reached before any bytes were sent, so the caller can
        fall back to the buffered path (which handles errors and compaction fallbacks).
        """
        upstream_body = build_upstream_body(server, body, force_stream=True)
        if upstream_body is None:
            return False
        request = build_upstream_request(server, upstream_body)
        context, insecure = upstream_context(server)

        # Retry transient upstream failures (HTTP 500 "Window limit exceeded", nginx
        # 500s, connection blips) BEFORE we send any bytes to the client. Once the SSE
        # stream has started we can no longer retry, but these errors surface at connect
        # time (as HTTPError), so retrying here absorbs the upstream's ~30% flakiness.
        tries, base = _retry_config()
        resp = None
        for attempt in range(tries):
            _reserve_upstream_slot()
            try:
                resp = urllib.request.urlopen(
                    request,
                    timeout=int(os.environ.get("HUANXIN_GLM52_UPSTREAM_TIMEOUT", "60")),
                    context=context,
                )
                _circuit_record_success()
                break
            except urllib.error.HTTPError as exc:
                raw_body = exc.read().decode("utf-8", "replace")
                try:
                    payload = json.loads(raw_body)
                except Exception:
                    message = "Huanxin inference gateway returned HTTP %s" % exc.code
                    if "404 -" in raw_body or "页面未找到" in raw_body:
                        message += ": subscription route not found"
                    payload = {"error": {"message": message, "type": "upstream_route_error"}}
                if is_retryable_payload(exc.code, payload) and attempt + 1 < tries:
                    if _is_rate_limit_error(exc.code, payload):
                        delay = min(base * (2**attempt) * 3.0, 30.0)
                    else:
                        delay = min(base * (2**attempt), 8.0)
                    _circuit_record_failure()
                    debug_log(
                        "stream retryable status=%s attempt=%s/%s sleep=%.1fs"
                        % (exc.code, attempt + 1, tries, delay)
                    )
                    time.sleep(delay)
                    continue
                _circuit_record_failure()
                return False  # non-retryable / exhausted -> buffered path reports the error
            except Exception as exc:
                if not insecure and _is_expired_cert_error(exc):
                    try:
                        resp = urllib.request.urlopen(
                            request,
                            timeout=int(os.environ.get("HUANXIN_GLM52_UPSTREAM_TIMEOUT", "60")),
                            context=server.insecure_context,
                        )  # type: ignore[attr-defined]
                        break
                    except Exception:
                        return False
                if attempt + 1 < tries:
                    delay = min(base * (2**attempt), 8.0)
                    debug_log(
                        "stream conn error attempt=%s/%s sleep=%.1fs: %r"
                        % (attempt + 1, tries, delay, exc)
                    )
                    time.sleep(delay)
                    continue
                return False
        if resp is None:
            return False

        content_type = resp.headers.get("Content-Type", "")
        if "text/event-stream" not in content_type:
            # Upstream ignored our stream request; fall back to buffered translation.
            raw = resp.read().decode("utf-8", "replace")
            resp.close()
            if raw.lstrip().startswith("data:"):
                upstream = parse_chat_stream(raw)
            else:
                try:
                    upstream = json.loads(raw)
                except Exception:
                    return False
            response = anthropic_response(server, body, upstream)
            self.write_stream(response)
            return True

        # Collect tool names so the writer can resolve GLM 5.2's nameless
        # streaming tool_call deltas (see AnthropicStreamWriter.finish()).
        request_tool_names: list[str] = []
        for tool in body.get("tools") or []:
            if isinstance(tool, dict):
                fn = tool.get("function") if isinstance(tool.get("function"), dict) else tool
                if isinstance(fn, dict) and isinstance(fn.get("name"), str):
                    request_tool_names.append(fn["name"])
        writer = AnthropicStreamWriter(
            self,
            f"msg_{uuid.uuid4().hex}",
            str(getattr(server, "model_name", "")),
            request_tool_names,
        )
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        writer.start()

        line_queue: queue.Queue[tuple[str, Any]] = queue.Queue()

        def reader() -> None:
            try:
                for raw_line in resp:
                    line_queue.put(("line", raw_line))
            except Exception as exc:  # pragma: no cover - upstream drop mid-stream
                line_queue.put(("error", exc))
            finally:
                line_queue.put(("done", None))

        thread = threading.Thread(target=reader, daemon=True)
        thread.start()

        line_count = 0
        try:
            while True:
                try:
                    kind, value = line_queue.get(timeout=2.0)
                except queue.Empty:
                    writer.maybe_ping()
                    continue
                if kind == "line":
                    line_count += 1
                    feed_stream_line(writer, value.decode("utf-8", "replace"))
                    writer.maybe_ping()
                elif kind == "error":
                    debug_log("stream_live upstream error mid-stream: %r" % value)
                    break
                else:  # done
                    break
        finally:
            writer.finish()
            try:
                resp.close()
            except Exception:
                pass
        if _DEBUG_LOG_PATH:
            debug_log(
                "STREAM model=%s n_msgs=%s tools=%s lines=%s any_output=%s stop=%s"
                % (
                    body.get("model"),
                    len(body.get("messages") or []),
                    len(body.get("tools") or []),
                    line_count,
                    writer.any_output,
                    writer.finish_reason,
                )
            )
        return True

    def write_stream(self, response: dict[str, Any]) -> None:
        events: list[dict[str, Any]] = [
            {"type": "message_start", "message": {**response, "content": []}}
        ]
        for index, block in enumerate(response.get("content") or []):
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use":
                input_json = json.dumps(block.get("input") or {}, separators=(",", ":"))
                events.extend(
                    [
                        {
                            "type": "content_block_start",
                            "index": index,
                            "content_block": {
                                "type": "tool_use",
                                "id": block["id"],
                                "name": block["name"],
                                "input": {},
                            },
                        },
                        {
                            "type": "content_block_delta",
                            "index": index,
                            "delta": {"type": "input_json_delta", "partial_json": input_json},
                        },
                        {"type": "content_block_stop", "index": index},
                    ]
                )
            else:
                text = block.get("text") if isinstance(block.get("text"), str) else ""
                events.extend(
                    [
                        {
                            "type": "content_block_start",
                            "index": index,
                            "content_block": {"type": "text", "text": ""},
                        },
                        {
                            "type": "content_block_delta",
                            "index": index,
                            "delta": {"type": "text_delta", "text": text},
                        },
                        {"type": "content_block_stop", "index": index},
                    ]
                )
        events.extend(
            [
                {
                    "type": "message_delta",
                    "delta": {"stop_reason": response["stop_reason"], "stop_sequence": None},
                    "usage": response["usage"],
                },
                {"type": "message_stop"},
            ]
        )
        try:
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            for event in events:
                self.wfile.write(f"event: {event['type']}\n".encode())
                self.wfile.write(f"data: {json.dumps(event, separators=(',', ':'))}\n\n".encode())
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            # Client (Claude CLI) hung up mid-stream (e.g. cancelled turn). This is
            # normal; swallow it so the worker thread does not spew a traceback.
            return

    def log_message(self, format: str, *args: Any) -> None:  # noqa: A003
        return


class QuietThreadingHTTPServer(ThreadingHTTPServer):
    """Threading server that stays up no matter what a single request does.

    * ``daemon_threads`` so worker threads never block interpreter shutdown.
    * ``allow_reuse_address`` so a supervisor can rebind the same port instantly
      after a restart (prevents transient ECONNREFUSED windows).
    * ``handle_error`` swallows the routine "client hung up" errors instead of
      dumping a traceback per cancelled turn.
    """

    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request: Any, client_address: Any) -> None:
        exc = sys.exc_info()[1]
        if isinstance(exc, (BrokenPipeError, ConnectionResetError, ConnectionAbortedError)):
            return
        super().handle_error(request, client_address)


def main() -> int:
    args = parse_args()
    server = QuietThreadingHTTPServer((args.host, args.port), Handler)
    server.upstream_url = args.upstream_url.rstrip("/") + "/v1/chat/completions"  # type: ignore[attr-defined]
    server.upstream_token = args.upstream_token  # type: ignore[attr-defined]
    server.model_name = args.model_name  # type: ignore[attr-defined]
    server.appcode = args.appcode or ""  # type: ignore[attr-defined]
    server.max_input_chars = args.max_input_chars  # type: ignore[attr-defined]
    server.insecure = args.insecure  # type: ignore[attr-defined]
    server.verify_context = ssl.create_default_context()  # type: ignore[attr-defined]
    insecure_context = ssl.create_default_context()
    insecure_context.check_hostname = False
    insecure_context.verify_mode = ssl.CERT_NONE
    server.insecure_context = insecure_context  # type: ignore[attr-defined]
    if args.insecure:
        sys.stderr.write(
            "[huanxin-proxy] WARNING: upstream TLS verification disabled (--insecure).\n"
        )
        sys.stderr.flush()
    try:
        server.serve_forever()
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
